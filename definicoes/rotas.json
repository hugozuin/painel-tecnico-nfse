      "campos": [
        {
          "id": "cnpj",
          "rotulo": "CNPJ do prestador",
          "tipo": "texto",
          "obrigatorio": true,
          "destino": "caminho.cnpj",
          "somenteNumeros": true
        }
      ],
      "resultado": {
        "tipo": "tabela",
        "colunas": [
          {
            "titulo": "Situação",
            "campo": "situacao",
            "estilo": "situacao"
          },
          {
            "titulo": "Número",
            "campo": "numeroNfse"
          },
          {
            "titulo": "Cód. verificação",
            "campo": "codigoVerificacao"
          },
          {
            "titulo": "Mensagem",
            "campo": "mensagem"
          }
        ]
      },
      "oculta": true
    },
    {
      "id": "consulta-periodo",
      "grupo": "Notas",
      "titulo": "Consulta por período",
      "resumo": "Lista as notas de um prestador em um intervalo de datas.",
      "metodo": "GET",
      "caminho": "/nfse/consultar/periodo",
      "entrada": {
        "tipo": "formulario"
      },
      "campos": [
        {
          "id": "cpfCnpj",
          "rotulo": "CPF ou CNPJ do prestador",
          "tipo": "texto",
          "obrigatorio": true,
          "destino": "consulta.cpfCnpj",
          "somenteNumeros": true
        },
        {
          "id": "dataInicial",
          "rotulo": "Data inicial",
          "tipo": "data",
          "obrigatorio": false,
          "destino": "consulta.dataInicial"
        },
        {
          "id": "dataFinal",
          "rotulo": "Data final",
          "tipo": "data",
          "obrigatorio": false,
          "destino": "consulta.dataFinal"
        },
        {
          "id": "hashProximaPagina",
          "rotulo": "Hash da próxima página",
          "tipo": "texto",
          "destino": "consulta.hashProximaPagina",
          "dica": "Preencha com o hash devolvido na consulta anterior para paginar."
        }
      ],
      "resultado": {
        "tipo": "json"
      },
      "observacao": "Traz até 25 notas por vez; para a próxima página, informe o hashProximaPagina devolvido. Só com o CPF ou CNPJ, traz todas as notas. O intervalo máximo é de 31 dias, a data considerada é a de recebimento da nota pelo PlugNotas e o retorno pode vir de um cache de até 300 segundos.",
      "oculta": true
    },
    {
      "id": "xml",
      "grupo": "Arquivos",
      "titulo": "Download de XML",
      "resumo": "Baixa o XML autorizado de cada nota informada.",
