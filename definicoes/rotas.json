{
  "versao": 1,
  "base": "https://api.plugnotas.com.br",
  "rotas": [
    {
      "id": "resolve",
      "grupo": "Notas",
      "titulo": "Resolve em lote",
      "resumo": "Sincroniza a situação das notas com a prefeitura e confere o desfecho na rota de consulta.",
      "tela": "resolve",
      "ordem": 1
    },
    {
      "id": "consulta",
      "grupo": "Notas",
      "titulo": "Consulta de notas",
      "resumo": "Consulta as notas pelo ID, pelo idIntegracao ou por período. Pelo ID, escolha entre a consulta simplificada e a completa.",
      "tela": "variantes",
      "variantes": [
        {
          "id": "id",
          "rotulo": "ID da nota",
          "rota": "consulta-id",
          "alternativa": "consulta-id-completa"
        },
        {
          "id": "integracao",
          "rotulo": "idIntegracao",
          "rota": "consulta-integracao"
        },
        {
          "id": "periodo",
          "rotulo": "Período",
          "rota": "consulta-periodo"
        }
      ],
      "ordem": 2,
      "alternancia": {
        "rotulo": "Consulta completa",
        "ligada": "Traz o documento inteiro gravado na emissão.",
        "desligada": "Desligado, traz o resumo com situação, número e mensagem.",
        "indisponivel": "A consulta por {variante} tem uma forma só."
      }
    },
    {
      "id": "consulta-id",
      "grupo": "Notas",
      "titulo": "Consulta simplificada por ID",
      "resumo": "Consulta resumida pela rota /nfse/consultar. Aceita id da nota ou protocolo.",
      "metodo": "GET",
      "caminho": "/nfse/consultar/{item}",
      "entrada": {
        "tipo": "lote",
        "rotulo": "IDs das notas ou protocolos",
        "exemplo": "ID da nota ou protocolo, um por linha"
      },
      "resultado": {
        "tipo": "tabela",
        "colunas": [
          {
            "titulo": "Situação",
            "campo": "situacao",
            "estilo": "situacao"
          },
          {
            "titulo": "Número",
            "campo": "numeroNfse"
          },
          {
            "titulo": "Série",
            "campo": "serie"
          },
          {
            "titulo": "Lote",
            "campo": "lote"
          },
          {
            "titulo": "Cód. verificação",
            "campo": "codigoVerificacao"
          },
          {
            "titulo": "Autorização",
            "campo": "autorizacao"
          },
          {
            "titulo": "Mensagem",
            "campo": "mensagem"
          }
        ]
      },
      "oculta": true
    },
    {
      "id": "consulta-id-completa",
      "grupo": "Notas",
      "titulo": "Consulta completa por ID",
      "resumo": "Retorna o documento inteiro pela rota /nfse/{id}, útil para conferir o que foi gravado na emissão.",
      "metodo": "GET",
      "caminho": "/nfse/{item}",
      "entrada": {
        "tipo": "lote",
        "rotulo": "IDs das notas ou protocolos",
        "exemplo": "ID da nota ou protocolo, um por linha"
      },
      "resultado": {
        "tipo": "json"
      },
      "oculta": true
    },
    {
      "id": "consulta-integracao",
