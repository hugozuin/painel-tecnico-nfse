      "titulo": "Consulta por idIntegracao",
      "resumo": "Consulta a nota pelo idIntegracao e pelo CNPJ do prestador.",
      "metodo": "GET",
      "caminho": "/nfse/consultar/{item}/{cnpj}",
      "entrada": {
        "tipo": "lote",
        "rotulo": "Valores de idIntegracao",
        "exemplo": "idIntegracao, um por linha"
