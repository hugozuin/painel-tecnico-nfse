      "metodo": "GET",
      "servidor": "sefin",
      "caminho": "/SefinNacional/dps/{item}",
      "entrada": {
        "tipo": "lote",
        "rotulo": "Identificadores de DPS",
        "exemplo": "Identificador da DPS, um por linha"
      },
      "resultado": {
        "tipo": "json"
      },
      "ordem": 6
    },
    {
      "id": "danfse",
      "grupo": "Nacional",
      "titulo": "DANFSe em PDF",
      "resumo": "Baixa o DANFSe pela chave de acesso.",
      "metodo": "GET",
      "servidor": "adn",
      "caminho": "/danfse/{item}",
      "entrada": {
        "tipo": "lote",
        "rotulo": "Chaves de acesso",
        "exemplo": "Chave de acesso, uma por linha"
      },
      "resultado": {
        "tipo": "arquivo",
