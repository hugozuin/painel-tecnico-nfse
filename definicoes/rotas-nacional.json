      "metodo": "GET",
      "servidor": "sefin",
      "caminho": "/SefinNacional/nfse/{item}",
      "entrada": {
        "tipo": "lote",
        "rotulo": "Chaves de acesso",
        "exemplo": "Chave de acesso, uma por linha"
      },
      "resultado": {
        "tipo": "json"
      },
      "ordem": 5
    },
    {
      "id": "dps",
      "grupo": "Nacional",
      "titulo": "DPS por identificador",
